COMPOSE_PROJECT_NAME=prueba-tecnica-mesasitec

# Images
NODE_IMAGE=node:24-alpine
DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0-alpine
DOTNET_ASPNET_IMAGE=mcr.microsoft.com/dotnet/aspnet:10.0-alpine

# Frontend
FRONTEND_HOST_PORT=5173
FRONTEND_CONTAINER_PORT=5173
FRONTEND_HEALTH_PATH=/
VITE_HOST=0.0.0.0
VITE_API_BASE_URL=/api

# Backend
BACKEND_SCHEME=http
BACKEND_SERVICE_HOST=backend
BACKEND_HOST_PORT=8080
BACKEND_CONTAINER_PORT=8080
BACKEND_HEALTH_PATH=/health
API_PROXY_TARGET=${BACKEND_SCHEME}://${BACKEND_SERVICE_HOST}:${BACKEND_CONTAINER_PORT}
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:${BACKEND_CONTAINER_PORT}
CORS_ALLOWED_ORIGINS=http://localhost:${FRONTEND_HOST_PORT}

#como ejemplo nada mas, por ahora aun no hay un secreto real, se debe generar uno largo y aleatorio para usarlo en produccion
JWT_SECRET=replace-with-a-long-random-value

# Docker runtime
HEALTHCHECK_INTERVAL=10s
HEALTHCHECK_TIMEOUT=3s
HEALTHCHECK_RETRIES=5
BACKEND_HEALTH_START_PERIOD=10s
FRONTEND_HEALTH_START_PERIOD=5s
RESTART_POLICY=unless-stopped
DOCKER_NETWORK_NAME=${COMPOSE_PROJECT_NAME}-network
DOCKER_NETWORK_DRIVER=bridge
